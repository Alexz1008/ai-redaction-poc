CORS_ALLOWED_ORIGINS=http://localhost:4200
# Local loopback requests only; never enable on a hosted backend.
DEV_AUTH_BYPASS=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
REDACTION_PROVIDER=foundry
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://alexz1008-foundry-hrs1.services.ai.azure.com/api/projects/proj-default
AZURE_FOUNDRY_AGENT_NAME=sac-redaction
AZURE_FOUNDRY_EXECUTION_MODE=native
# Only used when REDACTION_PROVIDER=language (rollback).
AZURE_LANGUAGE_ENDPOINT=
# Leave storage key empty for managed identity (Azure CLI sign-in locally).
# For Language rollback, either configure both keys or leave both empty.
AZURE_LANGUAGE_KEY=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_ORIGINALS_CONTAINER=originals
AZURE_STORAGE_REDACTED_CONTAINER=redacted
